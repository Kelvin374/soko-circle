{
  "expo": {
    "name": "Soko.circle",
    "slug": "Soko.circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "sokocircle",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001533",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SokoCircle uses your photos so you can attach images to posts you share with the network.",
          "cameraPermission": "SokoCircle uses your camera so you can take a photo to attach to your post.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
